# SQL Server connection (same database as the Node.js version)
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=PhonebookDb
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Docker Compose (used when running via docker compose) ---
# Dev-only fallback password for the containerized SQL Server.
# NEVER put a real password here — set it in .env (gitignored) instead.
MSSQL_SA_PASSWORD=Phonebook@12345

# Login (same defaults as the Node.js version)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Browser origins allowed to call the API directly (Vite dev servers).
# Not needed when frontend and API share one origin via Nginx.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# FastAPI listen address
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
